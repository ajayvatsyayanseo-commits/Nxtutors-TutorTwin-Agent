# Public site configuration. Everything here ships to the browser - no secrets.

# Where the FastAPI service lives. Meta and Cashfree also call this host.
NEXT_PUBLIC_API_URL=https://api.nxtutors.com

# Must match TUTORTWIN_CASHFREE_ENV on the API, or the checkout session is
# opened against the wrong gateway and fails with an unhelpful error.
NEXT_PUBLIC_CASHFREE_MODE=production

NEXT_PUBLIC_SITE_URL=https://nxtutortwin.nxtutors.com
