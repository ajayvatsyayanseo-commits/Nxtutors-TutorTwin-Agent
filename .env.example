# TutorTwin configuration. Copy to .env for local development.
# NEVER commit a real .env - this file holds placeholders only.

TUTORTWIN_ENVIRONMENT=local
TUTORTWIN_SERVICE_NAME=tutortwin-api

# Pooled DSN for application traffic (Neon pooled endpoint in production).
TUTORTWIN_DATABASE_URL=

# Direct DSN for Alembic. A transaction-pooling endpoint breaks DDL and
# advisory locks, so migrations must not use the pooled URL.
TUTORTWIN_DATABASE_MIGRATION_URL=

# Keep the per-container pool small: many short-lived serverless containers.
TUTORTWIN_DB_POOL_SIZE=2
TUTORTWIN_DB_MAX_OVERFLOW=2
TUTORTWIN_DB_POOL_RECYCLE_SECONDS=280
TUTORTWIN_DB_CONNECT_TIMEOUT_SECONDS=5
TUTORTWIN_DB_STATEMENT_TIMEOUT_MS=8000
TUTORTWIN_DB_HEALTH_TIMEOUT_SECONDS=2.0

# Shared secret for internal callers (Cloud Tasks, Lead Intake).
# Required when TUTORTWIN_ENVIRONMENT=production.
TUTORTWIN_INTERNAL_API_KEY=replace-me-with-a-generated-secret

TUTORTWIN_MAX_REQUEST_BYTES=262144

TUTORTWIN_LOG_LEVEL=INFO
# Leave false: student message text is PII and stays out of logs.
TUTORTWIN_LOG_MESSAGE_CONTENT=false

# No provider keys in Phase 01 - TutorTwin makes zero paid AI calls at this phase.
# OpenAI/Anthropic credentials arrive in Phase 02.

# --- control plane bootstrap --------------------------------------------------
#
# The first administrator, read by `python -m tutortwin.cli.admin bootstrap`.
# The command refuses to run once any administrator exists, so these cannot be
# used as a back door into a live system.
#
# The password is stored as an Argon2id PHC string, never in the clear: a .env is
# read by every process on the machine and leaks into shell history, backups and
# screen shares, so what lives here should be worthless to whoever reads it.
#
# Generate one with (it prompts, so nothing reaches shell history):
#
#     python -m tutortwin.cli.admin hash-password
#
TUTORTWIN_ADMIN_BOOTSTRAP_EMAIL=ops@example.com
TUTORTWIN_ADMIN_BOOTSTRAP_PASSWORD_HASH=

# Where the Next.js control plane (apps/admin) finds this API.
TUTORTWIN_API_URL=http://127.0.0.1:8000

# =============================================================================
# Phase 07: deployment, storage, queue and cost ceilings.
#
# Everything below is OPTIONAL locally. In staging or production the service
# REFUSES TO START without the storage and queue settings - see
# `Settings.require_deployable`. That is deliberate: each one fails silently
# otherwise, and a service that boots and loses data is worse than one that
# will not boot.
# =============================================================================

# --- object storage (Cloudflare R2) ------------------------------------------
# Unset locally, which selects the filesystem store under TUTORTWIN_MEDIA_ROOT.
# The bucket must be PRIVATE - no public-read policy, ever.
#TUTORTWIN_R2_ACCOUNT_ID=
#TUTORTWIN_R2_ACCESS_KEY_ID=
#TUTORTWIN_R2_SECRET_ACCESS_KEY=
#TUTORTWIN_R2_BUCKET=tutortwin-media
TUTORTWIN_MEDIA_RETENTION_DAYS=7

# --- async work (Cloud Tasks) ------------------------------------------------
# Unset locally, which records enqueues without dispatching them; local runs
# drive /internal/jobs/run directly.
#TUTORTWIN_TASKS_PROJECT=
#TUTORTWIN_TASKS_LOCATION=asia-south1
#TUTORTWIN_TASKS_QUEUE=tutortwin-media
#TUTORTWIN_TASKS_TARGET_URL=https://<api-service-url>/internal/jobs/run
#TUTORTWIN_TASKS_SERVICE_ACCOUNT=tutortwin-invoker@<project>.iam.gserviceaccount.com

# --- OIDC on the internal endpoints ------------------------------------------
# When set, /internal/* requires a Google-signed token for this audience issued
# to this service account. The shared key still authenticates /v1/events, whose
# caller (Lead Intake) is not on Google's identity plane.
#TUTORTWIN_OIDC_AUDIENCE=https://<api-service-url>
#TUTORTWIN_OIDC_SERVICE_ACCOUNT=tutortwin-invoker@<project>.iam.gserviceaccount.com

# --- system cost ceilings ----------------------------------------------------
# The platform's own limits, above whatever any plan allows. A plan bounds one
# student; these bound the bill. Micros = millionths of a unit, so 50000000 = $50.
TUTORTWIN_SYSTEM_DAILY_BUDGET_MICROS=50000000
# Spend *velocity*. A daily ceiling alone lets a retry loop burn the whole day's
# budget in four minutes and only notice afterwards.
TUTORTWIN_SYSTEM_HOURLY_BUDGET_MICROS=10000000
# Per vendor, so one provider's runaway cannot consume the other's headroom and
# leave the service with no working fallback.
TUTORTWIN_PROVIDER_DAILY_BUDGET_MICROS=30000000
TUTORTWIN_PROVIDER_FAILURE_CIRCUIT=5
TUTORTWIN_PROVIDER_CIRCUIT_WINDOW_MINUTES=10
# Media jobs allowed to run at once, fleet-wide. Bounds simultaneous OCR memory,
# vision spend and Postgres connections at the same time.
TUTORTWIN_HEAVY_JOB_MAX_CONCURRENCY=10

# --- per-student daily media ceilings ----------------------------------------
# Counted from the rows the pipeline already writes, never a separate counter.
TUTORTWIN_STUDENT_DAILY_PDF_PAGES=100
TUTORTWIN_STUDENT_DAILY_OCR_PAGES=60
TUTORTWIN_STUDENT_DAILY_VOICE_SECONDS=900
TUTORTWIN_STUDENT_DAILY_MOCKS=5
TUTORTWIN_STUDENT_MONTHLY_BUDGET_MICROS=20000000

# --- runtime -----------------------------------------------------------------
TUTORTWIN_REQUEST_TIMEOUT_SECONDS=120
# SIGTERM to hard stop. Must be <= the platform's own termination grace period,
# or the drain is cut off mid-request anyway.
TUTORTWIN_SHUTDOWN_GRACE_SECONDS=20
